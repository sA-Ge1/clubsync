############################################################
# APPLICATION CONFIGURATION
############################################################

# Public base URL of your Next.js app.
# Used for absolute redirects, OAuth callbacks, etc.
# In development: http://localhost:3000
# In production: https://yourdomain.com
NEXT_PUBLIC_BASE_URL="http://localhost:3000"


############################################################
# SUPABASE CONFIGURATION
############################################################

# Public Supabase project URL.
# Safe to expose in frontend because it only points to your project.
NEXT_PUBLIC_SUPABASE_URL=

# Public anonymous key (client-side usage).
# Used for browser authentication and public Supabase operations.
# DO NOT confuse with service role key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key with elevated privileges.
# Bypasses Row Level Security (RLS).
# MUST NEVER be exposed to the client.
SUPABASE_SERVICE_ROLE_KEY=


############################################################
# ADMIN / APP SECRETS
############################################################

# Custom admin access code (if you implemented protected admin routes).
# If used client-side, treat it carefully.
# Prefer server-side validation instead of exposing logic.
NEXT_PUBLIC_ADMIN_CODE=

# Default system email (e.g., for seed admin user or SMTP auth).
EMAIL=

# Default system password (use strong secrets in production).
PASSWORD=


############################################################
# UPSTASH REDIS (Caching / Rate Limiting / Queues)
############################################################

# REST endpoint for Upstash Redis instance.
# Used for server-side caching or rate limiting.
UPSTASH_REDIS_REST_URL=

# Auth token for Upstash REST API.
# Server-side only. Never expose to frontend.
UPSTASH_REDIS_REST_TOKEN=


############################################################
# AI / LLM PROVIDER API KEYS
############################################################

################ Vercel AI Gateway ################

# API key for Vercel AI Gateway (if routing LLM calls via Vercel).
AI_GATEWAY_API_KEY=

################ OpenAI ################

# OpenAI API key (GPT models).
# Server-side usage recommended.
OPENAI_API_KEY=

################ Google Gemini ################

# Google AI Studio / Gemini API key.
# Server-side usage recommended.
GOOGLE_API_KEY=

################ Anthropic Claude ################

# Anthropic API key for Claude models.
ANTHROPIC_API_KEY=

################ Groq ################

# Groq API key (ultra-fast inference provider).
GROQ_API_KEY=

################ OpenRouter ################

# OpenRouter API key (multi-provider routing).
OPENROUTER_API_KEY=


############################################################
# WEB SEARCH PROVIDER
############################################################

# Tavily API key (used for real-time web search tools).
# Typically used in RAG or AI agents.
TAVILY_API_KEY=